# ==========================================================
#  Modelo de configuração do Projeto M.A.D.A.R.A.
#
#  COPIE este arquivo para '.env' e preencha com as suas chaves:
#      cp .env.example .env
#
#  O '.env' está no .gitignore e NUNCA deve ser enviado ao GitHub.
#  Este '.env.example' é seguro: só tem os NOMES das variáveis.
# ==========================================================

# --- IA generativa (item 9) ---
# Crie uma chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=coloque_sua_chave_aqui

# --- Voz masculina original (edge-tts, requer internet) - OPCIONAL ---
# Estes já são os padrões. Descomente para personalizar:
# EDGE_VOICE=pt-BR-AntonioNeural
# EDGE_PITCH=-20Hz
# EDGE_RATE=+10%
# auto/edge tentam a voz original online e usam a voz offline do sistema se falhar.
# A voz offline depende das vozes instaladas e pode ser feminina.
# pyttsx3 usa somente a voz offline do Windows. Também pode usar --voz-motor pyttsx3.
VOZ_MOTOR=auto
# Após uma falha online, evita repetir a consulta a cada aviso.
VOZ_EDGE_RETRY_S=300

# --- Arduino (olhos e cabeça do boneco) - OPCIONAL ---
# A porta é detectada sozinha. Só preencha se a detecção falhar
# (rode 'python testar_arduino.py' para ver as portas disponíveis):
# ARDUINO_PORTA=COM3                      # Windows
# ARDUINO_PORTA=/dev/cu.usbmodem1101      # macOS

# Tamanho do balanço da cabeça no "madara hashirama": tempo, em ms, que o
# motor fica ligado do centro até cada lado. Maior = balanço mais largo.
# Ajuste com 'python testar_arduino.py'. O padrão, 60, foi o valor testado
# no boneco do grupo e vale para o Hashirama, o Sharingan e o Rinnegan.
# ARDUINO_BALANCO_MS=60

# Polaridade da consulta digital antiga por voz; o monitor exige calibração própria:
# ARDUINO_LUZ_ESCURO=1
# Modo digital: DO→8. Modo analogico: AO ou divisor resistivo→A0. Não há troca automática.
ARDUINO_RECONEXAO_S=5
ARDUINO_SEM_DADOS_S=10

# --- Energia que dá Lucro: configuração do ambiente físico ---
MAKER_LOJA_ID=mercado-01
MAKER_LOJA_NOME=Mercadinho de bairro (configure o nome)
MAKER_EQUIPAMENTO_ID=iluminacao-estoque
MAKER_AMBIENTE=estoque com pouca iluminação natural
# Montagem atual da equipe: VCC→5V, GND→GND, DO→8.
# Use analogico somente se AO/divisor estiver fisicamente conectado a A0.
MAKER_SENSOR_TIPO=digital
# Horários INICIAIS em Brasília (-03:00), todos os dias. Cruzamento de meia-noite aceito.
# expediente.json confirmado por voz prevalece SOMENTE nestes dois horários.
# Fica na pasta de registros selecionada. Não reescreve este arquivo nem o .env.
# Para padaria-01 use iluminacao-salao; padrão de expediente da padaria 06:00..20:00.
MAKER_ABERTURA=07:00
MAKER_FECHAMENTO=21:00
# Comandos: python maker_lab.py --voz --microfone
# Janela sem palavra Madara só durante o diálogo guiado: início da resposta e total.
MAKER_DIALOGO_ESPERA_S=8
MAKER_DIALOGO_TOTAL_S=120

# OBRIGATÓRIO medir estas referências nesta montagem: python testar_arduino.py --calibrar
# Deixe vazias até medir. Digital: 0 e 1 distintos; analogico: ADC 0..1023.
# Sem calibração não há classificação/alertas de energia.
MAKER_REFERENCIA_ESCURO=
MAKER_REFERENCIA_CLARO=
# auto deriva o sentido das referências. crescente/decrescente exigem coerência.
MAKER_SENTIDO=auto
# Analógico: escala relativa 0..1, não lux. Entra em >=0.70 e sai em <=0.50.
# Digital: índice binário calibrado. O limiar óptico é do módulo (trimpot, se houver).
MAKER_LIMIAR=0.60
MAKER_HISTERESE=0.10
MAKER_PERSISTENCIA_S=60
MAKER_PAUSA_ALERTA_S=300
# Cabeça acompanha cada aviso automático, com gesto breve; não a cada leitura.
# Independente de ARDUINO_BALANCO_MS, que continua controlando as cenas antigas.
# true/false; balanço 10..60 ms por trecho; duração >0 e <=5 s.
MAKER_MOTOR_AVISO=true
MAKER_MOTOR_BALANCO_MS=30
MAKER_MOTOR_DURACAO_S=2
MAKER_MAX_SEM_LEITURA_S=3
# Avaliação no PC. Analógico: telemetria fixa 500 ms; digital: consulta L a cada 1 s.
MAKER_INTERVALO_S=0.2
# Intervalo mínimo entre solicitações distintas de IA; uma solicitação por ocorrência.
MAKER_INTERVALO_IA_S=15
MAKER_IA_TIMEOUT_S=10
# groq usa a chave acima; ollama usa servidor local na porta 11434.
MAKER_IA_PROVEDOR=groq
# Modelo precisa existir no provedor. Para Ollama configure seu modelo instalado.
# MAKER_IA_MODELO=openai/gpt-oss-20b
# MAKER_IA_MODELO=llama3.2:3b
# Verificar autenticação/lista de modelos (sem gerar análise):
# python maker_lab.py --diagnostico-ia

# Pasta opcional para registros físicos; vazia usa dados/maker.
# Para testar fora do OneDrive: --pasta C:\Temp\madara-registros
# A pasta antiga não é movida nem apagada.
MAKER_DADOS_DIR=

# OPCIONAL: potência nominal TOTAL das lâmpadas observadas (kW) e tarifa em R$/kWh.
# Sem parâmetros reais documentados, custo é indisponível. Não há valor padrão.
# Pendências locais têm custo null e NÃO são exportadas ao contrato compartilhado.
MAKER_POTENCIA_KW=
MAKER_TARIFA_RS_KWH=
# Não é utilizado fator de perda de refrigeração.
# Simulação só com --demonstracao/--simular; falha do hardware nunca a ativa.
